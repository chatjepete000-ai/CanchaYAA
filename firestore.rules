rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNCIONES GENERALES
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function currentEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isLeagueAdmin(leagueId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/leagues/$(leagueId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/leagues/$(leagueId)
        ).data.adminUserIds;
    }

    function teamExists(teamId) {
      return exists(
        /databases/$(database)/documents/teams/$(teamId)
      );
    }

    function teamData(teamId) {
      return get(
        /databases/$(database)/documents/teams/$(teamId)
      ).data;
    }

    function isTeamManagerFromTeamDocument(teamId) {
      return isSignedIn()
        && teamExists(teamId)
        && request.auth.uid
          in teamData(teamId).managerUserIds;
    }

    function canManageJoinCode(
      teamId,
      leagueId,
      purpose
    ) {
      return (
        purpose == 'managerInvitation'
        && isLeagueAdmin(leagueId)
      )
      ||
      (
        purpose == 'playerInvitation'
        && (
          isLeagueAdmin(leagueId)
          ||
          isTeamManagerFromTeamDocument(teamId)
        )
      )
      ||
      (
        (
          purpose == 'teamCreation'
          ||
          purpose == 'manualRegeneration'
        )
        && isLeagueAdmin(leagueId)
      );
    }

    function isValidPlayerJoinCode(codeId) {
      return isSignedIn()

        && exists(
          /databases/$(database)/documents/teamJoinCodes/$(codeId)
        )

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(codeId)
        ).data.status == 'active'

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(codeId)
        ).data.purpose == 'playerInvitation'

        && (
          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedUserId == null

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedUserId == ''

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedUserId == request.auth.uid
        )

        && (
          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedEmail == null

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedEmail == ''

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedEmail == currentEmail()
        );
    }

    // courts: name<=100, address<=240, city<=100, sport enum,
    // nullable latitude/longitude, active, immutable createdBy/createdAt.
    // courtBookings: one immutable match/court/league/start per UTC 2h block.
    // tournamentMatches scheduling adds courtId/courtName/startsAt/bookingId.
    function isCourtAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function canEditCourt(data) {
      return isCourtAdmin() && (data.createdBy == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminScope == 'platform');
    }

    function courtText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function validCourt(data) {
      return data.keys().hasAll(['name', 'address', 'city', 'sport', 'latitude',
          'longitude', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'address', 'city', 'sport', 'latitude',
          'longitude', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && courtText(data.name, 100) && courtText(data.address, 240)
        && courtText(data.city, 100) && courtText(data.createdBy, 128)
        && data.sport in ['Fútbol 5', 'Fútbol 7', 'Fútbol 11', 'Usos múltiples']
        && data.active is bool
        && ((data.latitude == null && data.longitude == null)
          || (data.latitude is number && data.longitude is number
            && data.latitude >= -90 && data.latitude <= 90
            && data.longitude >= -180 && data.longitude <= 180))
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    match /courts/{courtId} {
      allow read: if isSignedIn();
      allow create: if isCourtAdmin() && validCourt(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if canEditCourt(resource.data) && validCourt(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function validCourtBooking(data, bookingId) {
      return data.keys().hasAll(['courtId', 'matchId', 'leagueId', 'startsAt'])
        && data.keys().hasOnly(['courtId', 'matchId', 'leagueId', 'startsAt'])
        && courtText(data.courtId, 128) && courtText(data.matchId, 256)
        && courtText(data.leagueId, 128) && data.startsAt is timestamp
        && data.startsAt > request.time
        && data.startsAt.toMillis() % 7200000 == 0
        && bookingId == data.courtId + '_' + string(data.startsAt.toMillis())
        && getAfter(/databases/$(database)/documents/tournamentMatches/$(data.matchId)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/tournamentMatches/$(data.matchId)).data.leagueId == data.leagueId
        && getAfter(/databases/$(database)/documents/tournamentMatches/$(data.matchId)).data.courtId == data.courtId
        && getAfter(/databases/$(database)/documents/tournamentMatches/$(data.matchId)).data.startsAt == data.startsAt;
    }

    match /courtBookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isLeagueAdmin(request.resource.data.leagueId)
        && validCourtBooking(request.resource.data, bookingId);
      allow update: if isSignedIn() && isLeagueAdmin(resource.data.leagueId)
        && request.resource.data == resource.data
        && validCourtBooking(request.resource.data, bookingId);
      allow delete: if isSignedIn() && isLeagueAdmin(resource.data.leagueId)
        && (!existsAfter(/databases/$(database)/documents/tournamentMatches/$(resource.data.matchId))
          || !('bookingId' in getAfter(/databases/$(database)/documents/tournamentMatches/$(resource.data.matchId)).data)
          || getAfter(/databases/$(database)/documents/tournamentMatches/$(resource.data.matchId)).data.bookingId != bookingId);
    }

    function teamSlotId(teamId, startsAt) {
      return teamId + '_' + string(startsAt.toMillis());
    }

    function validTeamBooking(data, bookingId) {
      let game = getAfter(/databases/$(database)/documents/tournamentMatches/$(data.matchId)).data;
      return data.keys().hasAll(['teamId', 'matchId', 'leagueId', 'startsAt'])
        && data.keys().hasOnly(['teamId', 'matchId', 'leagueId', 'startsAt'])
        && courtText(data.teamId, 128) && courtText(data.matchId, 256)
        && courtText(data.leagueId, 128) && data.startsAt is timestamp
        && data.startsAt > request.time && data.startsAt.toMillis() % 7200000 == 0
        && bookingId == teamSlotId(data.teamId, data.startsAt)
        && game.leagueId == data.leagueId && game.startsAt == data.startsAt
        && data.teamId in [game.homeTeamId, game.awayTeamId];
    }

    match /teamBookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isLeagueAdmin(request.resource.data.leagueId)
        && validTeamBooking(request.resource.data, bookingId);
      allow update: if isSignedIn() && isLeagueAdmin(resource.data.leagueId)
        && request.resource.data == resource.data
        && validTeamBooking(request.resource.data, bookingId);
      allow delete: if isSignedIn() && isLeagueAdmin(resource.data.leagueId)
        && (!existsAfter(/databases/$(database)/documents/tournamentMatches/$(resource.data.matchId))
          || !('startsAt' in getAfter(/databases/$(database)/documents/tournamentMatches/$(resource.data.matchId)).data)
          || getAfter(/databases/$(database)/documents/tournamentMatches/$(resource.data.matchId)).data.startsAt != resource.data.startsAt);
    }

    function oldTeamSlotsReleased(data) {
      return !('startsAt' in data)
        || (!existsAfter(/databases/$(database)/documents/teamBookings/$(teamSlotId(data.homeTeamId, data.startsAt)))
          && !existsAfter(/databases/$(database)/documents/teamBookings/$(teamSlotId(data.awayTeamId, data.startsAt))));
    }

    function validMatchVenue(data, matchId) {
      return data.keys().hasAll(['courtId', 'courtName', 'startsAt', 'bookingId'])
        && courtText(data.courtId, 128) && courtText(data.courtName, 100)
        && courtText(data.bookingId, 160) && data.startsAt is timestamp
        && data.startsAt > request.time
        && data.startsAt.toMillis() % 7200000 == 0
        && data.bookingId == data.courtId + '_' + string(data.startsAt.toMillis())
        && get(/databases/$(database)/documents/courts/$(data.courtId)).data.active == true
        && data.courtName == get(/databases/$(database)/documents/courts/$(data.courtId)).data.name
        && getAfter(/databases/$(database)/documents/courtBookings/$(data.bookingId)).data.matchId == matchId
        && getAfter(/databases/$(database)/documents/courtBookings/$(data.bookingId)).data.startsAt == data.startsAt
        && getAfter(/databases/$(database)/documents/courtBookings/$(data.bookingId)).data.courtId == data.courtId
        && getAfter(/databases/$(database)/documents/teamBookings/$(teamSlotId(data.homeTeamId, data.startsAt))).data.matchId == matchId
        && getAfter(/databases/$(database)/documents/teamBookings/$(teamSlotId(data.awayTeamId, data.startsAt))).data.matchId == matchId
        && data.updatedAt == request.time;
    }

    // ------------------------------------------------------------
    // DATOS VISUALES DE EQUIPOS (shortName / logoUrl)
    // ------------------------------------------------------------
    //
    // shortName: '' (sin abreviación) o de 2 a 20 caracteres.
    // logoUrl:   '' (escudo genérico) o URL HTTPS de máximo 2048
    //            caracteres.
    //
    // Los equipos históricos pueden NO tener shortName; por eso las
    // validaciones solo se aplican a los campos que realmente cambian.
    // ------------------------------------------------------------

    function validTeamShortName(value) {
      return value is string
        && (value.size() == 0
          || (value.size() >= 2 && value.size() <= 20));
    }

    function validTeamLogoUrl(value) {
      return value is string
        && (value.size() == 0
          || (value.size() <= 2048
            && value.matches('https://[^ ]+')));
    }

    function validTeamVisualUpdate(newData, oldData) {
      let changed = newData.diff(oldData).affectedKeys();
      return changed.hasOnly(['shortName', 'logoUrl', 'updatedAt'])
        && newData.updatedAt == request.time
        && (!changed.hasAny(['shortName'])
          || validTeamShortName(newData.shortName))
        && (!changed.hasAny(['logoUrl'])
          || validTeamLogoUrl(newData.logoUrl));
    }

    // ------------------------------------------------------------
    // EQUIPOS PÚBLICOS (publicTeams/{teamId})
    // ------------------------------------------------------------
    //
    // Espejo seguro de teams/{teamId}. Se valida contra el estado
    // FINAL del equipo (getAfter) porque la app actualiza teams y
    // publicTeams en el mismo batch.
    // ------------------------------------------------------------

    function teamPublicShortName(team) {
      return ('shortName' in team && team.shortName is string)
        ? team.shortName
        : '';
    }

    function teamPublicLogoUrl(team) {
      return ('logoUrl' in team && team.logoUrl is string)
        ? team.logoUrl
        : '';
    }

    function canWritePublicTeam(teamId, leagueId) {
      return isLeagueAdmin(leagueId)
        || isTeamManagerFromTeamDocument(teamId);
    }

    function validPublicTeam(data, teamId) {
      let team = getAfter(/databases/$(database)/documents/teams/$(teamId)).data;
      return existsAfter(/databases/$(database)/documents/teams/$(teamId))
        && data.keys().hasAll(['name', 'shortName', 'logoUrl',
          'leagueId', 'tournamentId', 'updatedAt'])
        && data.keys().hasOnly(['name', 'shortName', 'logoUrl',
          'leagueId', 'tournamentId', 'updatedAt'])
        && data.name is string && data.name.size() > 0
        && validTeamShortName(data.shortName)
        && validTeamLogoUrl(data.logoUrl)
        && data.leagueId is string
        && data.tournamentId is string
        && data.updatedAt == request.time
        && data.name == team.name
        && data.shortName == teamPublicShortName(team)
        && data.logoUrl == teamPublicLogoUrl(team)
        && data.leagueId == team.leagueId
        && data.tournamentId == team.tournamentId;
    }

    // publicTeams/{teamId} debe existir al terminar el batch y
    // coincidir con el estado FINAL de teams/{teamId}
    // (name, shortName, logoUrl, leagueId, tournamentId y
    // updatedAt == request.time). Funciona también cuando la ficha
    // pública se crea dentro del mismo batch.
    function publicTeamMatchesTeamAfter(teamId) {
      return existsAfter(/databases/$(database)/documents/publicTeams/$(teamId))
        && validPublicTeam(
          getAfter(/databases/$(database)/documents/publicTeams/$(teamId)).data,
          teamId
        );
    }

    // ============================================================
    // USUARIOS
    // ============================================================

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.role == 'player'
        && request.resource.data.adminScope == 'none'
        && request.resource.data.status == 'active';

      allow update: if isOwner(userId)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phone',
            'photoUrl',
            'position',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // ============================================================
    // LIGAS
    // ============================================================

    match /leagues/{leagueId} {

      allow read: if isSignedIn()
        && request.auth.uid
          in resource.data.adminUserIds;

      allow create, update, delete: if false;
    }

    // ============================================================
    // TORNEOS
    // ============================================================

    match /tournaments/{tournamentId} {

      allow read: if isSignedIn()
        && isLeagueAdmin(
          resource.data.leagueId
        );

      allow create: if isSignedIn()
        && request.resource.data.leagueId is string
        && isLeagueAdmin(
          request.resource.data.leagueId
        )
        && request.resource.data.createdByUserId
          == request.auth.uid
        && request.resource.data.status
          == 'draft'
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.city is string
        && request.resource.data.format is string;

      allow update: if isSignedIn()
        && isLeagueAdmin(
          resource.data.leagueId
        )
        && request.resource.data.leagueId
          == resource.data.leagueId
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'category',
            'city',
            'season',
            'format',
            'status',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // ============================================================
    // EQUIPOS
    // ============================================================

    match /teams/{teamId} {

      allow read: if isSignedIn()
        && (
          isLeagueAdmin(
            resource.data.leagueId
          )
          ||
          request.auth.uid
            in resource.data.managerUserIds
          ||
          request.auth.uid
            in resource.data.playerUserIds
        );

      allow create: if isSignedIn()
        && request.resource.data.leagueId is string
        && isLeagueAdmin(
          request.resource.data.leagueId
        )
        && request.resource.data.createdByUserId
          == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.tournamentId is string
        && request.resource.data.status == 'active'
        && request.resource.data.managerUserIds is list
        && request.resource.data.playerUserIds is list
        && validTeamShortName(
          request.resource.data.shortName
        )
        && validTeamLogoUrl(
          request.resource.data.logoUrl
        );

      // ----------------------------------------------------------
      // ADMIN DE LIGA
      // ----------------------------------------------------------
      //
      // logoUrl y shortName NO se modifican por esta regla; se
      // controlan exclusivamente en EDICIÓN VISUAL para mantener
      // sincronizado publicTeams/{teamId}.
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && isLeagueAdmin(
          resource.data.leagueId
        )

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'uniformDescription',
            'managerUserIds',
            'playerUserIds',
            'status',
            'lastManagerAssignmentId',
            'lastPlayerJoinCodeId',
            'updatedAt'
          ]);

      // ----------------------------------------------------------
      // ENCARGADO YA REGISTRADO
      // ----------------------------------------------------------
      //
      // Conserva la funcionalidad previa (name y uniformDescription).
      // logoUrl y shortName se controlan exclusivamente en
      // EDICIÓN VISUAL.
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && request.auth.uid
          in resource.data.managerUserIds

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.managerUserIds
          == resource.data.managerUserIds

        && request.resource.data.playerUserIds
          == resource.data.playerUserIds

        && request.resource.data.status
          == resource.data.status

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'uniformDescription',
            'updatedAt'
          ]);

      // ----------------------------------------------------------
      // EDICIÓN VISUAL (NOMBRE CORTO Y ESCUDO)
      // ----------------------------------------------------------
      //
      // Administrador de la liga o encargado de ESE equipo.
      // Solo pueden cambiar: shortName, logoUrl y updatedAt.
      // En el MISMO batch debe quedar publicTeams/{teamId}
      // sincronizado con el estado final del equipo.
      // No toca name, leagueId, tournamentId, status, managerUserIds,
      // playerUserIds, createdByUserId ni createdAt.
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && (
          isLeagueAdmin(
            resource.data.leagueId
          )
          ||
          isTeamManagerFromTeamDocument(
            teamId
          )
        )

        && validTeamVisualUpdate(
          request.resource.data,
          resource.data
        )

        && publicTeamMatchesTeamAfter(
          teamId
        );

      // ----------------------------------------------------------
      // PRIMER ENLACE DEL ENCARGADO AL EQUIPO
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && resource.data.managerUserIds is list

        && request.resource.data.managerUserIds is list

        && !(request.auth.uid
          in resource.data.managerUserIds)

        && request.auth.uid
          in request.resource.data.managerUserIds

        && request.resource.data.managerUserIds
          .hasAll(resource.data.managerUserIds)

        && request.resource.data.managerUserIds.size()
          == resource.data.managerUserIds.size() + 1

        && request.resource.data.lastManagerAssignmentId
          is string

        && exists(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        )

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.userId
          == request.auth.uid

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.teamId
          == teamId

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.leagueId
          == resource.data.leagueId

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.tournamentId
          == resource.data.tournamentId

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.role
          == 'teamManager'

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.status
          == 'active'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'managerUserIds',
            'lastManagerAssignmentId',
            'updatedAt'
          ]);

      // ----------------------------------------------------------
      // INGRESO DE JUGADOR MEDIANTE INVITACIÓN
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.managerUserIds
          == resource.data.managerUserIds

        && request.resource.data.status
          == resource.data.status

        && resource.data.playerUserIds is list

        && request.resource.data.playerUserIds is list

        && !(request.auth.uid
          in resource.data.playerUserIds)

        && request.auth.uid
          in request.resource.data.playerUserIds

        && request.resource.data.playerUserIds
          .hasAll(resource.data.playerUserIds)

        && request.resource.data.playerUserIds.size()
          == resource.data.playerUserIds.size() + 1

        && request.resource.data.lastPlayerJoinCodeId
          is string

        && isValidPlayerJoinCode(
          request.resource.data.lastPlayerJoinCodeId
        )

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.teamId
          == teamId

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.leagueId
          == resource.data.leagueId

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.tournamentId
          == resource.data.tournamentId

        && existsAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        )

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.userId
          == request.auth.uid

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.teamId
          == teamId

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.role
          == 'player'

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.status
          == 'active'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'playerUserIds',
            'lastPlayerJoinCodeId',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // ============================================================
    // EQUIPOS PÚBLICOS (SOLO DATOS VISUALES)
    // ============================================================
    //
    // Cualquier usuario autenticado puede leer nombre, nombre corto
    // y escudo para mostrar el calendario. Solo el administrador de
    // la liga o el encargado de ese equipo puede crear/actualizar la
    // ficha, y siempre debe coincidir con teams/{teamId}.
    // ============================================================

    match /publicTeams/{teamId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()

        && request.resource.data.leagueId is string

        && canWritePublicTeam(
          teamId,
          request.resource.data.leagueId
        )

        && validPublicTeam(
          request.resource.data,
          teamId
        );

      allow update: if isSignedIn()

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && canWritePublicTeam(
          teamId,
          resource.data.leagueId
        )

        && validPublicTeam(
          request.resource.data,
          teamId
        );

      allow delete: if false;
    }

    // ============================================================
    // CÓDIGOS DE INVITACIÓN
    // ============================================================

    match /teamJoinCodes/{codeId} {

      allow get: if isSignedIn();

      allow list: if false;

      allow create: if isSignedIn()

        && request.resource.data.keys().hasAll([
          'teamId',
          'leagueId',
          'tournamentId',
          'code',
          'status',
          'purpose',
          'delivery',
          'createdByUserId',
          'invitedUserId',
          'invitedEmail',
          'usedByUserId',
          'createdAt',
          'usedAt',
          'revokedAt',
          'expiresAt',
          'updatedAt',
          'revokedByUserId'
        ])

        && request.resource.data.keys().hasOnly([
          'teamId',
          'leagueId',
          'tournamentId',
          'code',
          'status',
          'purpose',
          'delivery',
          'createdByUserId',
          'invitedUserId',
          'invitedEmail',
          'usedByUserId',
          'createdAt',
          'usedAt',
          'revokedAt',
          'expiresAt',
          'updatedAt',
          'revokedByUserId'
        ])

        && request.resource.data.code == codeId

        && request.resource.data.teamId is string

        && request.resource.data.leagueId is string

        && request.resource.data.tournamentId is string

        && request.resource.data.createdByUserId
          == request.auth.uid

        && request.resource.data.status
          == 'active'

        && request.resource.data.purpose
          in [
            'managerInvitation',
            'playerInvitation'
          ]

        && request.resource.data.delivery
          in [
            'qr',
            'email'
          ]

        && request.resource.data.usedByUserId == null

        && request.resource.data.usedAt == null

        && request.resource.data.revokedAt == null

        && request.resource.data.revokedByUserId == null

        && request.resource.data.expiresAt == null

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && teamExists(
          request.resource.data.teamId
        )

        && teamData(
          request.resource.data.teamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.teamId
        ).tournamentId
          == request.resource.data.tournamentId

        && (
          (
            request.resource.data.purpose
              == 'managerInvitation'

            && isLeagueAdmin(
              request.resource.data.leagueId
            )
          )

          ||

          (
            request.resource.data.purpose
              == 'playerInvitation'

            && (
              isLeagueAdmin(
                request.resource.data.leagueId
              )

              ||

              isTeamManagerFromTeamDocument(
                request.resource.data.teamId
              )
            )
          )
        )

        && (
          (
            request.resource.data.delivery == 'qr'

            && request.resource.data.invitedUserId == null

            && request.resource.data.invitedEmail == null
          )

          ||

          (
            request.resource.data.delivery == 'email'

            && request.resource.data.invitedEmail is string

            && request.resource.data.invitedEmail
              == request.resource.data.invitedEmail.lower()

            && request.resource.data.invitedEmail.size() > 3

            && (
              request.resource.data.invitedUserId == null

              ||

              request.resource.data.invitedUserId is string
            )
          )
        );

      allow update: if isSignedIn()

        && request.resource.data.code
          == resource.data.code

        && request.resource.data.teamId
          == resource.data.teamId

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.purpose
          == resource.data.purpose

        && request.resource.data.delivery
          == resource.data.delivery

        && request.resource.data.createdByUserId
          == resource.data.createdByUserId

        && request.resource.data.invitedUserId
          == resource.data.invitedUserId

        && request.resource.data.invitedEmail
          == resource.data.invitedEmail

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.expiresAt
          == resource.data.expiresAt

        && (

          (
            resource.data.status == 'active'

            && request.resource.data.status
              == 'revoked'

            && canManageJoinCode(
              resource.data.teamId,
              resource.data.leagueId,
              resource.data.purpose
            )

            && request.resource.data.revokedByUserId
              == request.auth.uid

            && request.resource.data.revokedAt
              == request.time

            && request.resource.data.updatedAt
              == request.time

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'revokedAt',
                'revokedByUserId',
                'updatedAt'
              ])
          )

          ||

          (
            resource.data.status == 'active'

            && request.resource.data.status
              == 'used'

            && request.resource.data.usedByUserId
              == request.auth.uid

            && request.resource.data.usedAt
              == request.time

            && request.resource.data.updatedAt
              == request.time

            && (
              resource.data.invitedUserId == null

              ||

              resource.data.invitedUserId == ''

              ||

              resource.data.invitedUserId
                == request.auth.uid
            )

            && (
              resource.data.invitedEmail == null

              ||

              resource.data.invitedEmail == ''

              ||

              resource.data.invitedEmail
                == currentEmail()
            )

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'usedByUserId',
                'usedAt',
                'updatedAt'
              ])
          )
        );

      allow delete: if false;
    }

    // ============================================================
    // INVITACIONES A ENCARGADO
    // ============================================================

    match /teamManagerInvitations/{invitationId} {

      allow read: if isSignedIn()
        && (
          resource.data.invitedEmail
            == currentEmail()

          ||

          isLeagueAdmin(
            resource.data.leagueId
          )
        );

      allow create: if isSignedIn()

        && request.resource.data.teamId is string

        && request.resource.data.teamName is string

        && request.resource.data.leagueId is string

        && request.resource.data.tournamentId is string

        && request.resource.data.invitedEmail is string

        && request.resource.data.invitedEmail
          == request.resource.data.invitedEmail.lower()

        && request.resource.data.invitedByUserId
          == request.auth.uid

        && request.resource.data.invitedUserId == ''

        && request.resource.data.status == 'pending'

        && isLeagueAdmin(
          request.resource.data.leagueId
        )

        && teamExists(
          request.resource.data.teamId
        )

        && teamData(
          request.resource.data.teamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.teamId
        ).tournamentId
          == request.resource.data.tournamentId;

      allow update: if isSignedIn()

        && resource.data.invitedEmail
          == currentEmail()

        && resource.data.status == 'pending'

        && request.resource.data.teamId
          == resource.data.teamId

        && request.resource.data.teamName
          == resource.data.teamName

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.invitedEmail
          == resource.data.invitedEmail

        && request.resource.data.invitedByUserId
          == resource.data.invitedByUserId

        && request.resource.data.invitedUserId
          == request.auth.uid

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'invitedUserId',
            'acceptedAt',
            'rejectedAt',
            'updatedAt'
          ])

        && (
          (
            request.resource.data.status
              == 'active'

            && existsAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            )

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.userId
              == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.userEmail
              == currentEmail()

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.teamId
              == resource.data.teamId

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.leagueId
              == resource.data.leagueId

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.tournamentId
              == resource.data.tournamentId

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.role
              == 'teamManager'

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.status
              == 'active'
          )

          ||

          (
            request.resource.data.status
              == 'rejected'
          )
        );

      allow delete: if false;
    }

    // ============================================================
    // ASIGNACIONES DE EQUIPO
    // ============================================================

    match /teamAssignments/{assignmentId} {

      // ----------------------------------------------------------
      // LECTURA
      // ----------------------------------------------------------
      //
      // Puede consultar:
      // - el propio usuario
      // - el encargado de ese equipo
      // - el administrador de la liga
      //
      // Esto permite que el encargado consulte la plantilla
      // únicamente de los equipos que administra.
      // ----------------------------------------------------------

      allow read: if isSignedIn()
        && (
          resource.data.userId
            == request.auth.uid

          ||

          isTeamManagerFromTeamDocument(
            resource.data.teamId
          )

          ||

          isLeagueAdmin(
            resource.data.leagueId
          )
        );

      // ----------------------------------------------------------
      // CREAR ASIGNACIÓN DE ENCARGADO
      // ----------------------------------------------------------

      allow create: if isSignedIn()

        && exists(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        )

        && get(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.invitedEmail
          == currentEmail()

        && get(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.status
          == 'pending'

        && getAfter(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.status
          == 'active'

        && getAfter(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.invitedUserId
          == request.auth.uid

        && request.resource.data.userId
          == request.auth.uid

        && request.resource.data.userEmail
          == currentEmail()

        && request.resource.data.teamId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.teamId

        && request.resource.data.leagueId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.leagueId

        && request.resource.data.tournamentId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.tournamentId

        && request.resource.data.assignedByUserId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.invitedByUserId

        && request.resource.data.role
          == 'teamManager'

        && request.resource.data.status
          == 'active';

      // ----------------------------------------------------------
      // CREAR ASIGNACIÓN DE JUGADOR
      // ----------------------------------------------------------

      allow create: if isSignedIn()

        && isValidPlayerJoinCode(
          assignmentId
        )

        && request.resource.data.userId
          == request.auth.uid

        && request.resource.data.userEmail
          == currentEmail()

        && request.resource.data.teamId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.teamId

        && request.resource.data.leagueId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.leagueId

        && request.resource.data.tournamentId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.tournamentId

        && request.resource.data.assignedByUserId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.createdByUserId

        && request.resource.data.role
          == 'player'

        && request.resource.data.status
          == 'active'

        && request.resource.data.joinCodeId
          == assignmentId

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.acceptedAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && existsAfter(
          /databases/$(database)/documents/teams/$(request.resource.data.teamId)
        )

        && request.auth.uid in getAfter(
          /databases/$(database)/documents/teams/$(request.resource.data.teamId)
        ).data.playerUserIds

        && getAfter(
          /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
        ).data.status
          == 'used'

        && getAfter(
          /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
        ).data.usedByUserId
          == request.auth.uid;

      allow update, delete: if false;
    }

    // ============================================================
    // PARTIDOS DE TORNEO (CALENDARIO ROUND-ROBIN)
    // ============================================================

    match /tournamentMatches/{matchId} {

      // ----------------------------------------------------------
      // LECTURA
      // ----------------------------------------------------------
      //
      // Compatible con la consulta:
      //   .where('leagueId', isEqualTo: leagueId)
      //   .where('tournamentId', isEqualTo: tournamentId)
      //
      // Firestore valida que la consulta garantice que todos los
      // resultados cumplen la regla. Como la consulta filtra por
      // leagueId, resource.data.leagueId queda acotado y se puede
      // verificar que el usuario administra esa liga.
      // ----------------------------------------------------------

      // ==========================================================
      // LECTURA PÚBLICA DEL CALENDARIO DEPORTIVO
      // ==========================================================
      //
      // Cualquier usuario autenticado de CanchaYA puede consultar
     // los partidos del torneo.
     //
     // Esto incluye:
     //
      // scheduled  -> programado
     // postponed  -> pospuesto
     // completed  -> finalizado
    //
    // La lectura NO da permisos para modificar partidos.
   // Crear, editar, programar canchas y publicar resultados
   // siguen siendo operaciones protegidas para administradores.
   //
   // Esto permite mostrar:
   //
   // - todos los enfrentamientos;
   // - partidos pendientes de cancha;
   // - fecha y horario;
// - cancha asignada;
// - partidos pospuestos;
// - resultados;
// - calendario por día;
// - próximos partidos de cada equipo.
//
// ==========================================================

allow read: if isSignedIn();

      // ----------------------------------------------------------
      // CREAR PARTIDO
      // ----------------------------------------------------------

      allow create: if isSignedIn()

        && request.resource.data.keys().hasAll([
          'tournamentId',
          'leagueId',
          'roundNumber',
          'matchNumber',
          'homeTeamId',
          'homeTeamName',
          'awayTeamId',
          'awayTeamName',
          'status',
          'homeScore',
          'awayScore',
          'createdByUserId',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasOnly([
          'tournamentId',
          'leagueId',
          'roundNumber',
          'matchNumber',
          'homeTeamId',
          'homeTeamName',
          'awayTeamId',
          'awayTeamName',
          'status',
          'homeScore',
          'awayScore',
          'createdByUserId',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.leagueId is string
        && request.resource.data.tournamentId is string
        && request.resource.data.homeTeamId is string
        && request.resource.data.awayTeamId is string
        && request.resource.data.homeTeamName is string
        && request.resource.data.awayTeamName is string

        && isLeagueAdmin(
          request.resource.data.leagueId
        )

        && exists(
          /databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)
        )

        && get(
          /databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)
        ).data.leagueId
          == request.resource.data.leagueId

        && teamExists(
          request.resource.data.homeTeamId
        )

        && teamExists(
          request.resource.data.awayTeamId
        )

        && teamData(
          request.resource.data.homeTeamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.awayTeamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.homeTeamId
        ).tournamentId
          == request.resource.data.tournamentId

        && teamData(
          request.resource.data.awayTeamId
        ).tournamentId
          == request.resource.data.tournamentId

        && request.resource.data.homeTeamId
          != request.resource.data.awayTeamId

        && request.resource.data.roundNumber is int
        && request.resource.data.roundNumber > 0

        && request.resource.data.matchNumber is int
        && request.resource.data.matchNumber > 0

        && request.resource.data.status
          == 'scheduled'

        && request.resource.data.homeScore == null
        && request.resource.data.awayScore == null

        && request.resource.data.createdByUserId
          == request.auth.uid

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      // ----------------------------------------------------------
      // PROGRAMAR / REPROGRAMAR CANCHA Y HORARIO
      // ----------------------------------------------------------
      //
      // Solo administrador de liga.
      //
      // Permite:
      //   scheduled -> scheduled  (asignar o cambiar cancha/horario)
      //   postponed -> scheduled  (volver a programar)
      //
      // Solo pueden cambiar:
      //   courtId, courtName, startsAt, bookingId, status, updatedAt
      //
      // Se conservan validMatchVenue(), la liberación de
      // teamBookings anteriores y la baja de la reserva anterior
      // en courtBookings.
      // ----------------------------------------------------------

      allow update: if isSignedIn() && isLeagueAdmin(resource.data.leagueId)
        && resource.data.status in ['scheduled', 'postponed']
        && request.resource.data.status == 'scheduled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['courtId', 'courtName', 'startsAt', 'bookingId', 'status', 'updatedAt'])
        && validMatchVenue(request.resource.data, matchId)
        && (!('startsAt' in resource.data)
          || resource.data.startsAt == request.resource.data.startsAt
          || oldTeamSlotsReleased(resource.data))
        && (!('bookingId' in resource.data)
          || resource.data.bookingId == request.resource.data.bookingId
          || !existsAfter(/databases/$(database)/documents/courtBookings/$(resource.data.bookingId)));

      // ----------------------------------------------------------
      // POSPONER PARTIDO
      // ----------------------------------------------------------
      //
      // Solo administrador de liga.
      //
      //   scheduled -> postponed
      //
      // Se eliminan courtId, courtName, startsAt y bookingId.
      // Los marcadores no cambian. Deben quedar liberadas las
      // reservas anteriores de teamBookings y courtBookings.
      // ----------------------------------------------------------

      allow update: if isSignedIn() && isLeagueAdmin(resource.data.leagueId)
        && resource.data.status == 'scheduled'
        && request.resource.data.status == 'postponed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'courtId', 'courtName', 'startsAt', 'bookingId', 'updatedAt'])
        && !('courtId' in request.resource.data)
        && !('courtName' in request.resource.data)
        && !('startsAt' in request.resource.data)
        && !('bookingId' in request.resource.data)
        && request.resource.data.updatedAt == request.time
        && oldTeamSlotsReleased(resource.data)
        && (!('bookingId' in resource.data)
          || !existsAfter(/databases/$(database)/documents/courtBookings/$(resource.data.bookingId)));

      // ----------------------------------------------------------
      // PUBLICAR RESULTADO
      // ----------------------------------------------------------
      //
      // Solo administrador de liga.
      //
      //   scheduled -> completed
      //
      // Solo pueden cambiar: status, homeScore, awayScore y
      // updatedAt. Cancha, horario y reserva se conservan como
      // historial del partido disputado.
      // ----------------------------------------------------------

      allow update: if isSignedIn() && isLeagueAdmin(resource.data.leagueId)
        && resource.data.status == 'scheduled'
        && resource.data.homeScore == null
        && resource.data.awayScore == null
        && request.resource.data.status == 'completed'
        && request.resource.data.homeScore is int
        && request.resource.data.homeScore >= 0
        && request.resource.data.awayScore is int
        && request.resource.data.awayScore >= 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'homeScore', 'awayScore', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // ----------------------------------------------------------
      // BORRAR (solo para regenerar calendario sin resultados)
      // ----------------------------------------------------------
      //
      // Solo administrador de liga y solo partidos scheduled o
      // postponed sin marcador. Los partidos completed forman
      // parte del historial y no se pueden borrar.
      // ----------------------------------------------------------

      allow delete: if isSignedIn()
        && isLeagueAdmin(
          resource.data.leagueId
        )
        && resource.data.status in ['scheduled', 'postponed']
        && resource.data.homeScore == null
        && resource.data.awayScore == null
        && oldTeamSlotsReleased(resource.data)
        && (!('bookingId' in resource.data)
          || !existsAfter(/databases/$(database)/documents/courtBookings/$(resource.data.bookingId)));
    }

           // ============================================================
    // NOTIFICACIONES
    // ============================================================

    match /notifications/{notificationId} {

      // Cada usuario solo puede leer las notificaciones
      // que fueron creadas específicamente para su UID.
      //
      // Compatible con consultas como:
      //   .where('recipientUserId', isEqualTo: request.auth.uid)
      allow read: if isSignedIn()
        && resource.data.recipientUserId
          == request.auth.uid;

      // Las notificaciones se crearán únicamente desde un entorno
      // confiable del servidor. El cliente Flutter no puede
      // fabricar notificaciones arbitrarias.
      allow create: if false;

      // El usuario destinatario únicamente puede cambiar una
      // notificación de no leída -> leída.
      //
      // No puede modificar:
      // - recipientUserId
      // - title
      // - body
      // - type
      // - senderUserId
      // - teamId
      // - tournamentId
      // - matchId
      // - invitationId
      // - route
      // - data
      // - createdAt
      allow update: if isSignedIn()

        && resource.data.recipientUserId
          == request.auth.uid

        && request.resource.data.recipientUserId
          == resource.data.recipientUserId

        && resource.data.isRead == false

        && request.resource.data.isRead == true

        && request.resource.data.readAt
          == request.time

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'isRead',
            'readAt'
          ]);

      // Las notificaciones forman parte del historial de la cuenta
      // y no se eliminan desde el cliente.
      allow delete: if false;
    }    


    // ============================================================
    // DISPOSITIVOS PUSH DEL USUARIO
    // ============================================================

    match /users/{userId}/pushDevices/{installationId} {

      // El propio usuario puede consultar un dispositivo concreto.
      // No se permite listar la colección para evitar exponer tokens.
      allow get: if isOwner(userId);
      allow list: if false;

      // Cada usuario únicamente puede registrar dispositivos
      // dentro de su propia cuenta.
      allow create: if isOwner(userId)

        && request.resource.data.keys().hasAll([
          'userId',
          'installationId',
          'fcmToken',
          'platform',
          'enabled',
          'permissionStatus',
          'createdAt',
          'lastSeenAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasOnly([
          'userId',
          'installationId',
          'fcmToken',
          'platform',
          'enabled',
          'permissionStatus',
          'createdAt',
          'lastSeenAt',
          'updatedAt'
        ])

        && request.resource.data.userId
          == request.auth.uid

        && request.resource.data.installationId
          == installationId

        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() > 0

        && request.resource.data.platform
          in [
            'android',
            'ios',
            'macos'
          ]

        && request.resource.data.enabled is bool

        && request.resource.data.permissionStatus
          in [
            'authorized',
            'denied',
            'notDetermined',
            'provisional'
          ]

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.lastSeenAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      // El dueño puede renovar el token o actualizar el estado
      // del mismo dispositivo, pero no cambiar su identidad.
      allow update: if isOwner(userId)

        && resource.data.userId
          == request.auth.uid

        && request.resource.data.userId
          == resource.data.userId

        && request.resource.data.installationId
          == resource.data.installationId

        && request.resource.data.installationId
          == installationId

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() > 0

        && request.resource.data.platform
          in [
            'android',
            'ios',
            'macos'
          ]

        && request.resource.data.enabled is bool

        && request.resource.data.permissionStatus
          in [
            'authorized',
            'denied',
            'notDetermined',
            'provisional'
          ]

        && request.resource.data.lastSeenAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'fcmToken',
            'platform',
            'enabled',
            'permissionStatus',
            'lastSeenAt',
            'updatedAt'
          ]);

      // Al cerrar sesión podemos quitar ese dispositivo
      // de la cuenta actual.
      allow delete: if isOwner(userId)
        && resource.data.userId
          == request.auth.uid
        && resource.data.installationId
          == installationId;
    }


    // ============================================================
    // TODO LO DEMÁS BLOQUEADO
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
