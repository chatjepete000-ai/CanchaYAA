rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNCIONES GENERALES
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function currentEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isLeagueAdmin(leagueId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/leagues/$(leagueId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/leagues/$(leagueId)
        ).data.adminUserIds;
    }

    function teamExists(teamId) {
      return exists(
        /databases/$(database)/documents/teams/$(teamId)
      );
    }

    function teamData(teamId) {
      return get(
        /databases/$(database)/documents/teams/$(teamId)
      ).data;
    }

    function isTeamManagerFromTeamDocument(teamId) {
      return isSignedIn()
        && teamExists(teamId)
        && request.auth.uid
          in teamData(teamId).managerUserIds;
    }

    function canManageJoinCode(
      teamId,
      leagueId,
      purpose
    ) {
      return (
        purpose == 'managerInvitation'
        && isLeagueAdmin(leagueId)
      )
      ||
      (
        purpose == 'playerInvitation'
        && (
          isLeagueAdmin(leagueId)
          ||
          isTeamManagerFromTeamDocument(teamId)
        )
      )
      ||
      (
        (
          purpose == 'teamCreation'
          ||
          purpose == 'manualRegeneration'
        )
        && isLeagueAdmin(leagueId)
      );
    }

    function isValidPlayerJoinCode(codeId) {
      return isSignedIn()

        && exists(
          /databases/$(database)/documents/teamJoinCodes/$(codeId)
        )

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(codeId)
        ).data.status == 'active'

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(codeId)
        ).data.purpose == 'playerInvitation'

        && (
          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedUserId == null

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedUserId == ''

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedUserId == request.auth.uid
        )

        && (
          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedEmail == null

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedEmail == ''

          ||

          get(
            /databases/$(database)/documents/teamJoinCodes/$(codeId)
          ).data.invitedEmail == currentEmail()
        );
    }

    // ============================================================
    // USUARIOS
    // ============================================================

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.role == 'player'
        && request.resource.data.adminScope == 'none'
        && request.resource.data.status == 'active';

      allow update: if isOwner(userId)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phone',
            'photoUrl',
            'position',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // ============================================================
    // LIGAS
    // ============================================================

    match /leagues/{leagueId} {

      allow read: if isSignedIn()
        && request.auth.uid
          in resource.data.adminUserIds;

      allow create, update, delete: if false;
    }

    // ============================================================
    // TORNEOS
    // ============================================================

    match /tournaments/{tournamentId} {

      allow read: if isSignedIn()
        && isLeagueAdmin(
          resource.data.leagueId
        );

      allow create: if isSignedIn()
        && request.resource.data.leagueId is string
        && isLeagueAdmin(
          request.resource.data.leagueId
        )
        && request.resource.data.createdByUserId
          == request.auth.uid
        && request.resource.data.status
          == 'draft'
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.city is string
        && request.resource.data.format is string;

      allow update: if isSignedIn()
        && isLeagueAdmin(
          resource.data.leagueId
        )
        && request.resource.data.leagueId
          == resource.data.leagueId
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'category',
            'city',
            'season',
            'format',
            'status',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // ============================================================
    // EQUIPOS
    // ============================================================

    match /teams/{teamId} {

      allow read: if isSignedIn()
        && (
          isLeagueAdmin(
            resource.data.leagueId
          )
          ||
          request.auth.uid
            in resource.data.managerUserIds
          ||
          request.auth.uid
            in resource.data.playerUserIds
        );

      allow create: if isSignedIn()
        && request.resource.data.leagueId is string
        && isLeagueAdmin(
          request.resource.data.leagueId
        )
        && request.resource.data.createdByUserId
          == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.tournamentId is string
        && request.resource.data.status == 'active'
        && request.resource.data.managerUserIds is list
        && request.resource.data.playerUserIds is list;

      // ----------------------------------------------------------
      // ADMIN DE LIGA
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && isLeagueAdmin(
          resource.data.leagueId
        )

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'logoUrl',
            'uniformDescription',
            'managerUserIds',
            'playerUserIds',
            'status',
            'lastManagerAssignmentId',
            'lastPlayerJoinCodeId',
            'updatedAt'
          ]);

      // ----------------------------------------------------------
      // ENCARGADO YA REGISTRADO
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && request.auth.uid
          in resource.data.managerUserIds

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.managerUserIds
          == resource.data.managerUserIds

        && request.resource.data.playerUserIds
          == resource.data.playerUserIds

        && request.resource.data.status
          == resource.data.status

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'logoUrl',
            'uniformDescription',
            'updatedAt'
          ]);

      // ----------------------------------------------------------
      // PRIMER ENLACE DEL ENCARGADO AL EQUIPO
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && resource.data.managerUserIds is list

        && request.resource.data.managerUserIds is list

        && !(request.auth.uid
          in resource.data.managerUserIds)

        && request.auth.uid
          in request.resource.data.managerUserIds

        && request.resource.data.managerUserIds
          .hasAll(resource.data.managerUserIds)

        && request.resource.data.managerUserIds.size()
          == resource.data.managerUserIds.size() + 1

        && request.resource.data.lastManagerAssignmentId
          is string

        && exists(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        )

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.userId
          == request.auth.uid

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.teamId
          == teamId

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.leagueId
          == resource.data.leagueId

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.tournamentId
          == resource.data.tournamentId

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.role
          == 'teamManager'

        && get(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastManagerAssignmentId)
        ).data.status
          == 'active'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'managerUserIds',
            'lastManagerAssignmentId',
            'updatedAt'
          ]);

      // ----------------------------------------------------------
      // INGRESO DE JUGADOR MEDIANTE INVITACIÓN
      // ----------------------------------------------------------

      allow update: if isSignedIn()

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.managerUserIds
          == resource.data.managerUserIds

        && request.resource.data.status
          == resource.data.status

        && resource.data.playerUserIds is list

        && request.resource.data.playerUserIds is list

        && !(request.auth.uid
          in resource.data.playerUserIds)

        && request.auth.uid
          in request.resource.data.playerUserIds

        && request.resource.data.playerUserIds
          .hasAll(resource.data.playerUserIds)

        && request.resource.data.playerUserIds.size()
          == resource.data.playerUserIds.size() + 1

        && request.resource.data.lastPlayerJoinCodeId
          is string

        && isValidPlayerJoinCode(
          request.resource.data.lastPlayerJoinCodeId
        )

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.teamId
          == teamId

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.leagueId
          == resource.data.leagueId

        && get(
          /databases/$(database)/documents/teamJoinCodes/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.tournamentId
          == resource.data.tournamentId

        && existsAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        )

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.userId
          == request.auth.uid

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.teamId
          == teamId

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.role
          == 'player'

        && getAfter(
          /databases/$(database)/documents/teamAssignments/$(request.resource.data.lastPlayerJoinCodeId)
        ).data.status
          == 'active'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'playerUserIds',
            'lastPlayerJoinCodeId',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // ============================================================
    // CÓDIGOS DE INVITACIÓN
    // ============================================================

    match /teamJoinCodes/{codeId} {

      allow get: if isSignedIn();

      allow list: if false;

      allow create: if isSignedIn()

        && request.resource.data.keys().hasAll([
          'teamId',
          'leagueId',
          'tournamentId',
          'code',
          'status',
          'purpose',
          'delivery',
          'createdByUserId',
          'invitedUserId',
          'invitedEmail',
          'usedByUserId',
          'createdAt',
          'usedAt',
          'revokedAt',
          'expiresAt',
          'updatedAt',
          'revokedByUserId'
        ])

        && request.resource.data.keys().hasOnly([
          'teamId',
          'leagueId',
          'tournamentId',
          'code',
          'status',
          'purpose',
          'delivery',
          'createdByUserId',
          'invitedUserId',
          'invitedEmail',
          'usedByUserId',
          'createdAt',
          'usedAt',
          'revokedAt',
          'expiresAt',
          'updatedAt',
          'revokedByUserId'
        ])

        && request.resource.data.code == codeId

        && request.resource.data.teamId is string

        && request.resource.data.leagueId is string

        && request.resource.data.tournamentId is string

        && request.resource.data.createdByUserId
          == request.auth.uid

        && request.resource.data.status
          == 'active'

        && request.resource.data.purpose
          in [
            'managerInvitation',
            'playerInvitation'
          ]

        && request.resource.data.delivery
          in [
            'qr',
            'email'
          ]

        && request.resource.data.usedByUserId == null

        && request.resource.data.usedAt == null

        && request.resource.data.revokedAt == null

        && request.resource.data.revokedByUserId == null

        && request.resource.data.expiresAt == null

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && teamExists(
          request.resource.data.teamId
        )

        && teamData(
          request.resource.data.teamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.teamId
        ).tournamentId
          == request.resource.data.tournamentId

        && (
          (
            request.resource.data.purpose
              == 'managerInvitation'

            && isLeagueAdmin(
              request.resource.data.leagueId
            )
          )

          ||

          (
            request.resource.data.purpose
              == 'playerInvitation'

            && (
              isLeagueAdmin(
                request.resource.data.leagueId
              )

              ||

              isTeamManagerFromTeamDocument(
                request.resource.data.teamId
              )
            )
          )
        )

        && (
          (
            request.resource.data.delivery == 'qr'

            && request.resource.data.invitedUserId == null

            && request.resource.data.invitedEmail == null
          )

          ||

          (
            request.resource.data.delivery == 'email'

            && request.resource.data.invitedEmail is string

            && request.resource.data.invitedEmail
              == request.resource.data.invitedEmail.lower()

            && request.resource.data.invitedEmail.size() > 3

            && (
              request.resource.data.invitedUserId == null

              ||

              request.resource.data.invitedUserId is string
            )
          )
        );

      allow update: if isSignedIn()

        && request.resource.data.code
          == resource.data.code

        && request.resource.data.teamId
          == resource.data.teamId

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.purpose
          == resource.data.purpose

        && request.resource.data.delivery
          == resource.data.delivery

        && request.resource.data.createdByUserId
          == resource.data.createdByUserId

        && request.resource.data.invitedUserId
          == resource.data.invitedUserId

        && request.resource.data.invitedEmail
          == resource.data.invitedEmail

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.expiresAt
          == resource.data.expiresAt

        && (

          (
            resource.data.status == 'active'

            && request.resource.data.status
              == 'revoked'

            && canManageJoinCode(
              resource.data.teamId,
              resource.data.leagueId,
              resource.data.purpose
            )

            && request.resource.data.revokedByUserId
              == request.auth.uid

            && request.resource.data.revokedAt
              == request.time

            && request.resource.data.updatedAt
              == request.time

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'revokedAt',
                'revokedByUserId',
                'updatedAt'
              ])
          )

          ||

          (
            resource.data.status == 'active'

            && request.resource.data.status
              == 'used'

            && request.resource.data.usedByUserId
              == request.auth.uid

            && request.resource.data.usedAt
              == request.time

            && request.resource.data.updatedAt
              == request.time

            && (
              resource.data.invitedUserId == null

              ||

              resource.data.invitedUserId == ''

              ||

              resource.data.invitedUserId
                == request.auth.uid
            )

            && (
              resource.data.invitedEmail == null

              ||

              resource.data.invitedEmail == ''

              ||

              resource.data.invitedEmail
                == currentEmail()
            )

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'usedByUserId',
                'usedAt',
                'updatedAt'
              ])
          )
        );

      allow delete: if false;
    }

    // ============================================================
    // INVITACIONES A ENCARGADO
    // ============================================================

    match /teamManagerInvitations/{invitationId} {

      allow read: if isSignedIn()
        && (
          resource.data.invitedEmail
            == currentEmail()

          ||

          isLeagueAdmin(
            resource.data.leagueId
          )
        );

      allow create: if isSignedIn()

        && request.resource.data.teamId is string

        && request.resource.data.teamName is string

        && request.resource.data.leagueId is string

        && request.resource.data.tournamentId is string

        && request.resource.data.invitedEmail is string

        && request.resource.data.invitedEmail
          == request.resource.data.invitedEmail.lower()

        && request.resource.data.invitedByUserId
          == request.auth.uid

        && request.resource.data.invitedUserId == ''

        && request.resource.data.status == 'pending'

        && isLeagueAdmin(
          request.resource.data.leagueId
        )

        && teamExists(
          request.resource.data.teamId
        )

        && teamData(
          request.resource.data.teamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.teamId
        ).tournamentId
          == request.resource.data.tournamentId;

      allow update: if isSignedIn()

        && resource.data.invitedEmail
          == currentEmail()

        && resource.data.status == 'pending'

        && request.resource.data.teamId
          == resource.data.teamId

        && request.resource.data.teamName
          == resource.data.teamName

        && request.resource.data.leagueId
          == resource.data.leagueId

        && request.resource.data.tournamentId
          == resource.data.tournamentId

        && request.resource.data.invitedEmail
          == resource.data.invitedEmail

        && request.resource.data.invitedByUserId
          == resource.data.invitedByUserId

        && request.resource.data.invitedUserId
          == request.auth.uid

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'invitedUserId',
            'acceptedAt',
            'rejectedAt',
            'updatedAt'
          ])

        && (
          (
            request.resource.data.status
              == 'active'

            && existsAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            )

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.userId
              == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.userEmail
              == currentEmail()

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.teamId
              == resource.data.teamId

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.leagueId
              == resource.data.leagueId

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.tournamentId
              == resource.data.tournamentId

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.role
              == 'teamManager'

            && getAfter(
              /databases/$(database)/documents/teamAssignments/$(invitationId)
            ).data.status
              == 'active'
          )

          ||

          (
            request.resource.data.status
              == 'rejected'
          )
        );

      allow delete: if false;
    }

    // ============================================================
    // ASIGNACIONES DE EQUIPO
    // ============================================================

    match /teamAssignments/{assignmentId} {

      // ----------------------------------------------------------
      // LECTURA
      // ----------------------------------------------------------
      //
      // Puede consultar:
      // - el propio usuario
      // - el encargado de ese equipo
      // - el administrador de la liga
      //
      // Esto permite que el encargado consulte la plantilla
      // únicamente de los equipos que administra.
      // ----------------------------------------------------------

      allow read: if isSignedIn()
        && (
          resource.data.userId
            == request.auth.uid

          ||

          isTeamManagerFromTeamDocument(
            resource.data.teamId
          )

          ||

          isLeagueAdmin(
            resource.data.leagueId
          )
        );

      // ----------------------------------------------------------
      // CREAR ASIGNACIÓN DE ENCARGADO
      // ----------------------------------------------------------

      allow create: if isSignedIn()

        && exists(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        )

        && get(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.invitedEmail
          == currentEmail()

        && get(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.status
          == 'pending'

        && getAfter(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.status
          == 'active'

        && getAfter(
          /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
        ).data.invitedUserId
          == request.auth.uid

        && request.resource.data.userId
          == request.auth.uid

        && request.resource.data.userEmail
          == currentEmail()

        && request.resource.data.teamId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.teamId

        && request.resource.data.leagueId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.leagueId

        && request.resource.data.tournamentId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.tournamentId

        && request.resource.data.assignedByUserId
          == get(
            /databases/$(database)/documents/teamManagerInvitations/$(assignmentId)
          ).data.invitedByUserId

        && request.resource.data.role
          == 'teamManager'

        && request.resource.data.status
          == 'active';

      // ----------------------------------------------------------
      // CREAR ASIGNACIÓN DE JUGADOR
      // ----------------------------------------------------------

      allow create: if isSignedIn()

        && isValidPlayerJoinCode(
          assignmentId
        )

        && request.resource.data.userId
          == request.auth.uid

        && request.resource.data.userEmail
          == currentEmail()

        && request.resource.data.teamId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.teamId

        && request.resource.data.leagueId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.leagueId

        && request.resource.data.tournamentId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.tournamentId

        && request.resource.data.assignedByUserId
          == get(
            /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
          ).data.createdByUserId

        && request.resource.data.role
          == 'player'

        && request.resource.data.status
          == 'active'

        && request.resource.data.joinCodeId
          == assignmentId

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.acceptedAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && existsAfter(
          /databases/$(database)/documents/teams/$(request.resource.data.teamId)
        )

        && request.auth.uid in getAfter(
          /databases/$(database)/documents/teams/$(request.resource.data.teamId)
        ).data.playerUserIds

        && getAfter(
          /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
        ).data.status
          == 'used'

        && getAfter(
          /databases/$(database)/documents/teamJoinCodes/$(assignmentId)
        ).data.usedByUserId
          == request.auth.uid;

      allow update, delete: if false;
    }

    // ============================================================
    // PARTIDOS DE TORNEO (CALENDARIO ROUND-ROBIN)
    // ============================================================

    match /tournamentMatches/{matchId} {

      // ----------------------------------------------------------
      // LECTURA
      // ----------------------------------------------------------
      //
      // Compatible con la consulta:
      //   .where('leagueId', isEqualTo: leagueId)
      //   .where('tournamentId', isEqualTo: tournamentId)
      //
      // Firestore valida que la consulta garantice que todos los
      // resultados cumplen la regla. Como la consulta filtra por
      // leagueId, resource.data.leagueId queda acotado y se puede
      // verificar que el usuario administra esa liga.
      // ----------------------------------------------------------

      allow read: if isSignedIn()
        && isLeagueAdmin(
          resource.data.leagueId
        );

      // ----------------------------------------------------------
      // CREAR PARTIDO
      // ----------------------------------------------------------

      allow create: if isSignedIn()

        && request.resource.data.keys().hasAll([
          'tournamentId',
          'leagueId',
          'roundNumber',
          'matchNumber',
          'homeTeamId',
          'homeTeamName',
          'awayTeamId',
          'awayTeamName',
          'status',
          'homeScore',
          'awayScore',
          'createdByUserId',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasOnly([
          'tournamentId',
          'leagueId',
          'roundNumber',
          'matchNumber',
          'homeTeamId',
          'homeTeamName',
          'awayTeamId',
          'awayTeamName',
          'status',
          'homeScore',
          'awayScore',
          'createdByUserId',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.leagueId is string
        && request.resource.data.tournamentId is string
        && request.resource.data.homeTeamId is string
        && request.resource.data.awayTeamId is string
        && request.resource.data.homeTeamName is string
        && request.resource.data.awayTeamName is string

        && isLeagueAdmin(
          request.resource.data.leagueId
        )

        && exists(
          /databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)
        )

        && get(
          /databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)
        ).data.leagueId
          == request.resource.data.leagueId

        && teamExists(
          request.resource.data.homeTeamId
        )

        && teamExists(
          request.resource.data.awayTeamId
        )

        && teamData(
          request.resource.data.homeTeamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.awayTeamId
        ).leagueId
          == request.resource.data.leagueId

        && teamData(
          request.resource.data.homeTeamId
        ).tournamentId
          == request.resource.data.tournamentId

        && teamData(
          request.resource.data.awayTeamId
        ).tournamentId
          == request.resource.data.tournamentId

        && request.resource.data.homeTeamId
          != request.resource.data.awayTeamId

        && request.resource.data.roundNumber is int
        && request.resource.data.roundNumber > 0

        && request.resource.data.matchNumber is int
        && request.resource.data.matchNumber > 0

        && request.resource.data.status
          == 'scheduled'

        && request.resource.data.homeScore == null
        && request.resource.data.awayScore == null

        && request.resource.data.createdByUserId
          == request.auth.uid

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      // ----------------------------------------------------------
      // ACTUALIZAR (los resultados se implementarán después)
      // ----------------------------------------------------------

      allow update: if false;

      // ----------------------------------------------------------
      // BORRAR (solo para regenerar calendario sin resultados)
      // ----------------------------------------------------------

      allow delete: if isSignedIn()
        && isLeagueAdmin(
          resource.data.leagueId
        )
        && resource.data.status == 'scheduled'
        && resource.data.homeScore == null
        && resource.data.awayScore == null;
    }

           // ============================================================
    // NOTIFICACIONES
    // ============================================================

    match /notifications/{notificationId} {

      // Cada usuario solo puede leer las notificaciones
      // que fueron creadas específicamente para su UID.
      //
      // Compatible con consultas como:
      //   .where('recipientUserId', isEqualTo: request.auth.uid)
      allow read: if isSignedIn()
        && resource.data.recipientUserId
          == request.auth.uid;

      // Las notificaciones se crearán únicamente desde un entorno
      // confiable del servidor. El cliente Flutter no puede
      // fabricar notificaciones arbitrarias.
      allow create: if false;

      // El usuario destinatario únicamente puede cambiar una
      // notificación de no leída -> leída.
      //
      // No puede modificar:
      // - recipientUserId
      // - title
      // - body
      // - type
      // - senderUserId
      // - teamId
      // - tournamentId
      // - matchId
      // - invitationId
      // - route
      // - data
      // - createdAt
      allow update: if isSignedIn()

        && resource.data.recipientUserId
          == request.auth.uid

        && request.resource.data.recipientUserId
          == resource.data.recipientUserId

        && resource.data.isRead == false

        && request.resource.data.isRead == true

        && request.resource.data.readAt
          == request.time

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'isRead',
            'readAt'
          ]);

      // Las notificaciones forman parte del historial de la cuenta
      // y no se eliminan desde el cliente.
      allow delete: if false;
    }    


    // ============================================================
    // DISPOSITIVOS PUSH DEL USUARIO
    // ============================================================

    match /users/{userId}/pushDevices/{installationId} {

      // El propio usuario puede consultar un dispositivo concreto.
      // No se permite listar la colección para evitar exponer tokens.
      allow get: if isOwner(userId);
      allow list: if false;

      // Cada usuario únicamente puede registrar dispositivos
      // dentro de su propia cuenta.
      allow create: if isOwner(userId)

        && request.resource.data.keys().hasAll([
          'userId',
          'installationId',
          'fcmToken',
          'platform',
          'enabled',
          'permissionStatus',
          'createdAt',
          'lastSeenAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasOnly([
          'userId',
          'installationId',
          'fcmToken',
          'platform',
          'enabled',
          'permissionStatus',
          'createdAt',
          'lastSeenAt',
          'updatedAt'
        ])

        && request.resource.data.userId
          == request.auth.uid

        && request.resource.data.installationId
          == installationId

        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() > 0

        && request.resource.data.platform
          in [
            'android',
            'ios',
            'macos'
          ]

        && request.resource.data.enabled is bool

        && request.resource.data.permissionStatus
          in [
            'authorized',
            'denied',
            'notDetermined',
            'provisional'
          ]

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.lastSeenAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      // El dueño puede renovar el token o actualizar el estado
      // del mismo dispositivo, pero no cambiar su identidad.
      allow update: if isOwner(userId)

        && resource.data.userId
          == request.auth.uid

        && request.resource.data.userId
          == resource.data.userId

        && request.resource.data.installationId
          == resource.data.installationId

        && request.resource.data.installationId
          == installationId

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() > 0

        && request.resource.data.platform
          in [
            'android',
            'ios',
            'macos'
          ]

        && request.resource.data.enabled is bool

        && request.resource.data.permissionStatus
          in [
            'authorized',
            'denied',
            'notDetermined',
            'provisional'
          ]

        && request.resource.data.lastSeenAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'fcmToken',
            'platform',
            'enabled',
            'permissionStatus',
            'lastSeenAt',
            'updatedAt'
          ]);

      // Al cerrar sesión podemos quitar ese dispositivo
      // de la cuenta actual.
      allow delete: if isOwner(userId)
        && resource.data.userId
          == request.auth.uid
        && resource.data.installationId
          == installationId;
    }


    // ============================================================
    // TODO LO DEMÁS BLOQUEADO
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}